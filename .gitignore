# The build runner publishes a convenience symlink at the repo root for
# every requested target, named after the target - an open-ended set
# that grows with build.py. Ignore the whole root and whitelist the
# sources instead of chasing names; a new real root file needs its own
# ! line here, which is deliberate.
/*
!/.clang-format
!/.github
!/.gitignore
!/CONTRIBUTING.md
!/LICENSE
!/LICENSE.GPL3
!/LICENSE.MIT
!/README.md
!/STYLE.md
!/STYLE_PRJ.md
!/bin
!/build
!/build.py
!/codecov.yml
!/dev
!/docs
!/ext
!/flake.lock
!/flake.nix
!/lib
!/shell.nix
!/tst

# Anywhere in the tree.
__pycache__/
.codegraph/
# Raw LLVM profiles: a coverage run drops these wherever it was started, and
# one already reached the tree by accident (tst/default.profraw, 491300ce).
# That one stays - deleting it would be a permanent divergence for 621 KB -
# but the next one does not get in.
*.profraw
/bounce*.log
/ext/plt/plt_unit_tests
/ext/plt/plt_wayland_integration_tests

