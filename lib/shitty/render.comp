#version 450

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

@OUTPUT_DECLARATION@

struct Cell
{
   uint codepoint;
   uint charData;
   uint fg;
   uint bg;
   uint underlineColor;
   uint hyperlink;
   uint strip;
   uint stripStride;
   uint semantic;
   uint lineAttribute;
};

struct CellUpdate
{
   uint sourceIndex;
   uint outputIndex;
   Cell cell;
};

layout (std430, set = 0, binding = 1) readonly buffer CellBuffer
{
   CellUpdate updates[];
};

layout (std430, set = 0, binding = 2) readonly buffer MaskArena
{
   uint maskArena[];
};

layout (std430, set = 0, binding = 3) readonly buffer ColorArena
{
   uint colorArena[];
};

layout (push_constant) uniform PushConstants
{
   uint glyphWidth;
   uint glyphHeight;
   float boxDrawingStroke;
   uint columns;
   uint rows;
   uint outputWidth;
   uint outputHeight;
   uint originX;
   uint originY;
   uint cursorColor;
   int cursorX;
   int cursorY;
   uint cursorStyle;
   uint screenReverseVideo;
   int selectionLeft;
   int selectionTop;
   int selectionRight;
   int selectionBottom;
   uint rectangularSelection;
   uint showWraps;
   uint selectionForeground;
   uint selectionBackground;
   uint selectionColorMask;
   uint blinkVisible;
   uint cursorBlink;
   uint hoveredHyperlink;
   uint hoveredLinkBegin;
   uint hoveredLinkEnd;
   uint updateCount;
   uint cursorKeepSelectionFg;
} parameters;

vec3 unpackColor (uint color)
{
   return vec3 (
      float (bitfieldExtract (color, 0, 8)),
      float (bitfieldExtract (color, 8, 8)),
      float (bitfieldExtract (color, 16, 8))) / 255.0;
}

void storePixel (ivec2 position, vec3 color)
{
   if (position.x < 0 || position.y < 0 ||
       position.x >= int (parameters.outputWidth) ||
       position.y >= int (parameters.outputHeight))
      return;
@OUTPUT_STORE@
}

bool selectedCoordinate (ivec2 cellPosition)
{
   if (parameters.rectangularSelection != 0)
   {
      return cellPosition.y >= parameters.selectionTop &&
             cellPosition.y <= parameters.selectionBottom &&
             cellPosition.x >= parameters.selectionLeft &&
             cellPosition.x < parameters.selectionRight;
   }

   return
      (cellPosition.y > parameters.selectionTop &&
       cellPosition.y < parameters.selectionBottom) ||
      (cellPosition.y == parameters.selectionTop &&
       cellPosition.x >= parameters.selectionLeft &&
       (cellPosition.y < parameters.selectionBottom ||
        cellPosition.x < parameters.selectionRight)) ||
      (cellPosition.y == parameters.selectionBottom &&
       cellPosition.x < parameters.selectionRight &&
       (cellPosition.y > parameters.selectionTop ||
        cellPosition.x > parameters.selectionLeft));
}

bool selected (ivec2 cellPosition, uint doubleWidth)
{
   return selectedCoordinate (cellPosition) ||
          (doubleWidth != 0 &&
           selectedCoordinate (cellPosition + ivec2 (1, 0)));
}

const uint boxDrawingData [128] = uint [128] (
   0x0005u, 0x000au, 0x0050u, 0x00a0u,
   0x6005u, 0x600au, 0x6050u, 0x60a0u,
   0x8005u, 0x800au, 0x8050u, 0x80a0u,
   0x0044u, 0x0048u, 0x0084u, 0x0088u,
   0x0041u, 0x0042u, 0x0081u, 0x0082u,
   0x0014u, 0x0018u, 0x0024u, 0x0028u,
   0x0011u, 0x0012u, 0x0021u, 0x0022u,
   0x0054u, 0x0058u, 0x0064u, 0x0094u,
   0x00a4u, 0x0068u, 0x0098u, 0x00a8u,
   0x0051u, 0x0052u, 0x0061u, 0x0091u,
   0x00a1u, 0x0062u, 0x0092u, 0x00a2u,
   0x0045u, 0x0046u, 0x0049u, 0x004au,
   0x0085u, 0x0086u, 0x0089u, 0x008au,
   0x0015u, 0x0016u, 0x0019u, 0x001au,
   0x0025u, 0x0026u, 0x0029u, 0x002au,
   0x0055u, 0x0056u, 0x0059u, 0x005au,
   0x0065u, 0x0095u, 0x00a5u, 0x0066u,
   0x0069u, 0x0096u, 0x0099u, 0x006au,
   0x009au, 0x00a6u, 0x00a9u, 0x00aau,
   0x4005u, 0x400au, 0x4050u, 0x40a0u,
   0x000fu, 0x00f0u, 0x004cu, 0x00c4u,
   0x00ccu, 0x0043u, 0x00c1u, 0x00c3u,
   0x001cu, 0x0034u, 0x003cu, 0x0013u,
   0x0031u, 0x0033u, 0x005cu, 0x00f4u,
   0x00fcu, 0x0053u, 0x00f1u, 0x00f3u,
   0x004fu, 0x00c5u, 0x00cfu, 0x001fu,
   0x0035u, 0x003fu, 0x005fu, 0x00f5u,
   0x00ffu, 0x0444u, 0x0441u, 0x0411u,
   0x0414u, 0x0800u, 0x1000u, 0x1800u,
   0x0001u, 0x0010u, 0x0004u, 0x0040u,
   0x0002u, 0x0020u, 0x0008u, 0x0080u,
   0x0009u, 0x0090u, 0x0006u, 0x0060u);

float intervalCoverage (int coordinate, float first, float last)
{
   float pixelFirst = float (coordinate);
   return clamp (min (pixelFirst + 1.0, last) - max (pixelFirst, first), 0.0, 1.0);
}

float rectangleCoverage (ivec2 pixel, vec4 bounds)
{
   if (bounds.z <= bounds.x || bounds.w <= bounds.y)
      return 0.0;
   return intervalCoverage (pixel.x, bounds.x, bounds.z) *
          intervalCoverage (pixel.y, bounds.y, bounds.w);
}

void addRectangle (inout float coverage, ivec2 pixel, vec4 bounds)
{
   float addition = rectangleCoverage (pixel, bounds);
   coverage = max (coverage, addition);
}

float strokeCenter (int size, float thickness)
{
   int rounded = int (thickness + 0.5);
   return float (size / 2) + ((rounded & 1) != 0 ? 0.5 : 0.0);
}

bool inDash (int coordinate, int length, uint count)
{
   if (count == 0)
      return true;

   int partCount = int (count * 2 - 1);
   int part = coordinate * partCount / length;
   return (part & 1) == 0;
}

float diagonalCoverage (ivec2 pixel, ivec2 size, uint data,
                        float lightThickness)
{
   vec2 position = vec2 (pixel) + vec2 (0.5);
   vec2 dimensions = vec2 (size);
   float normalLength = length (dimensions);
   float distance = dimensions.y * position.x -
                    dimensions.x * position.y;
   float otherDistance = dimensions.y * position.x +
                         dimensions.x * position.y -
                         dimensions.x * dimensions.y;
   float nearest = 1e10;
   if ((data & 0x0800u) != 0)
      nearest = min (nearest, abs (otherDistance) / normalLength);
   if ((data & 0x1000u) != 0)
      nearest = min (nearest, abs (distance) / normalLength);
   return clamp (lightThickness * 0.5 + 0.5 - nearest, 0.0, 1.0);
}

float arcCoverage (ivec2 pixel, ivec2 size, uint data,
                   float lightThickness)
{
   float centerX = strokeCenter (size.x, lightThickness);
   float centerY = strokeCenter (size.y, lightThickness);
   bool left = (data & 0x0003u) != 0;
   bool up = (data & 0x0030u) != 0;
   vec2 extent = vec2 (
      left ? centerX : float (size.x) - centerX,
      up ? centerY : float (size.y) - centerY);
   vec2 oppositeExtent = vec2 (
      left ? float (size.x) - centerX : centerX,
      up ? float (size.y) - centerY : centerY);
   float radius = min (min (extent.x, oppositeExtent.x),
                       min (extent.y, oppositeExtent.y));
   vec2 direction = (vec2 (pixel) + vec2 (0.5) - vec2 (centerX, centerY)) *
                    vec2 (left ? -1.0 : 1.0, up ? -1.0 : 1.0);

   // A circular quarter arc on the short side, with tangent straight tails
   // to the cell edges. A half-cell ellipse becomes a tall U in the usual
   // 1:2 terminal cell and joins its neighboring straight with a kink.
   float nearest = 1e10;
   if (direction.x >= 0.0 && direction.y >= 0.0)
      nearest = abs (length (direction) - radius);
   vec2 horizontal = vec2 (clamp (direction.x, radius, extent.x), 0.0);
   nearest = min (nearest, distance (direction, horizontal));
   vec2 vertical = vec2 (0.0, clamp (direction.y, radius, extent.y));
   nearest = min (nearest, distance (direction, vertical));
   return clamp (lightThickness * 0.5 + 0.5 - nearest, 0.0, 1.0);
}

float axisAlignedCoverage (uint data, ivec2 pixel, ivec2 size,
                           float lightThickness)
{
   float centerX = strokeCenter (size.x, lightThickness);
   float centerY = strokeCenter (size.y, lightThickness);
   float heavyThickness = lightThickness * 2.0;
   float hLightTop = centerY - lightThickness * 0.5;
   float hLightBottom = centerY + lightThickness * 0.5;
   float hHeavyTop = centerY - heavyThickness * 0.5;
   float hHeavyBottom = centerY + heavyThickness * 0.5;
   float hDoubleTop = centerY - lightThickness * 1.5;
   float hDoubleBottom = centerY + lightThickness * 1.5;
   float vLightLeft = centerX - lightThickness * 0.5;
   float vLightRight = centerX + lightThickness * 0.5;
   float vHeavyLeft = centerX - heavyThickness * 0.5;
   float vHeavyRight = centerX + heavyThickness * 0.5;
   float vDoubleLeft = centerX - lightThickness * 1.5;
   float vDoubleRight = centerX + lightThickness * 1.5;

   uint left = bitfieldExtract (data, 0, 2);
   uint right = bitfieldExtract (data, 2, 2);
   uint up = bitfieldExtract (data, 4, 2);
   uint down = bitfieldExtract (data, 6, 2);

   // Keep a straight subpixel stem whole. Splitting it at the center would
   // make the two fractional end caps lose coverage where they meet.
   if (up == 0 && down == 0 && left == right && left != 0)
   {
      if (left == 1)
         return rectangleCoverage (pixel, vec4 (0.0, hLightTop, float (size.x), hLightBottom));
      if (left == 2)
         return rectangleCoverage (pixel, vec4 (0.0, hHeavyTop, float (size.x), hHeavyBottom));
      float straight = rectangleCoverage (pixel, vec4 (0.0, hDoubleTop, float (size.x), hLightTop));
      addRectangle (straight, pixel, vec4 (0.0, hLightBottom, float (size.x), hDoubleBottom));
      return straight;
   }
   if (left == 0 && right == 0 && up == down && up != 0)
   {
      if (up == 1)
         return rectangleCoverage (pixel, vec4 (vLightLeft, 0.0, vLightRight, float (size.y)));
      if (up == 2)
         return rectangleCoverage (pixel, vec4 (vHeavyLeft, 0.0, vHeavyRight, float (size.y)));
      float straight = rectangleCoverage (pixel, vec4 (vDoubleLeft, 0.0, vLightLeft, float (size.y)));
      addRectangle (straight, pixel, vec4 (vLightRight, 0.0, vDoubleRight, float (size.y)));
      return straight;
   }

   float upBottom = left == 2 || right == 2 ? hHeavyBottom :
      left != right || down == up ? left == 3 || right == 3 ? hDoubleBottom : hLightBottom :
      left == 0 && right == 0 ? hLightBottom : hLightTop;
   float downTop = left == 2 || right == 2 ? hHeavyTop :
      left != right || up == down ? left == 3 || right == 3 ? hDoubleTop : hLightTop :
      left == 0 && right == 0 ? hLightTop : hLightBottom;
   float leftRight = up == 2 || down == 2 ? vHeavyRight :
      up != down || left == right ? up == 3 || down == 3 ? vDoubleRight : vLightRight :
      up == 0 && down == 0 ? vLightRight : vLightLeft;
   float rightLeft = up == 2 || down == 2 ? vHeavyLeft :
      up != down || right == left ? up == 3 || down == 3 ? vDoubleLeft : vLightLeft :
      up == 0 && down == 0 ? vLightLeft : vLightRight;

   float coverage = 0.0;
   if (up == 1)
      addRectangle (coverage, pixel, vec4 (vLightLeft, 0.0, vLightRight, upBottom));
   else if (up == 2)
      addRectangle (coverage, pixel, vec4 (vHeavyLeft, 0.0, vHeavyRight, upBottom));
   else if (up == 3)
   {
      float leftBottom = left == 3 ? hLightTop : upBottom;
      float rightBottom = right == 3 ? hLightTop : upBottom;
      addRectangle (coverage, pixel, vec4 (vDoubleLeft, 0.0, vLightLeft, leftBottom));
      addRectangle (coverage, pixel, vec4 (vLightRight, 0.0, vDoubleRight, rightBottom));
   }
   if (right == 1)
      addRectangle (coverage, pixel, vec4 (rightLeft, hLightTop, float (size.x), hLightBottom));
   else if (right == 2)
      addRectangle (coverage, pixel, vec4 (rightLeft, hHeavyTop, float (size.x), hHeavyBottom));
   else if (right == 3)
   {
      float topLeft = up == 3 ? vLightRight : rightLeft;
      float bottomLeft = down == 3 ? vLightRight : rightLeft;
      addRectangle (coverage, pixel, vec4 (topLeft, hDoubleTop, float (size.x), hLightTop));
      addRectangle (coverage, pixel, vec4 (bottomLeft, hLightBottom, float (size.x), hDoubleBottom));
   }
   if (down == 1)
      addRectangle (coverage, pixel, vec4 (vLightLeft, downTop, vLightRight, float (size.y)));
   else if (down == 2)
      addRectangle (coverage, pixel, vec4 (vHeavyLeft, downTop, vHeavyRight, float (size.y)));
   else if (down == 3)
   {
      float leftTop = left == 3 ? hLightBottom : downTop;
      float rightTop = right == 3 ? hLightBottom : downTop;
      addRectangle (coverage, pixel, vec4 (vDoubleLeft, leftTop, vLightLeft, float (size.y)));
      addRectangle (coverage, pixel, vec4 (vLightRight, rightTop, vDoubleRight, float (size.y)));
   }
   if (left == 1)
      addRectangle (coverage, pixel, vec4 (0.0, hLightTop, leftRight, hLightBottom));
   else if (left == 2)
      addRectangle (coverage, pixel, vec4 (0.0, hHeavyTop, leftRight, hHeavyBottom));
   else if (left == 3)
   {
      float topRight = up == 3 ? vLightLeft : leftRight;
      float bottomRight = down == 3 ? vLightLeft : leftRight;
      addRectangle (coverage, pixel, vec4 (0.0, hDoubleTop, topRight, hLightTop));
      addRectangle (coverage, pixel, vec4 (0.0, hLightBottom, bottomRight, hDoubleBottom));
   }
   return coverage;
}

float boxDrawingCoverage (uint codepoint, ivec2 pixel, ivec2 size)
{
   uint data = boxDrawingData [codepoint - 0x2500u];
   float lightThickness = max (0.001, parameters.boxDrawingStroke);

   if ((data & 0x1800u) != 0)
      return diagonalCoverage (pixel, size, data, lightThickness);
   if ((data & 0x0400u) != 0)
      return arcCoverage (pixel, size, data, lightThickness);

   uint dashCount = bitfieldExtract (data, 13, 3);
   uint left = bitfieldExtract (data, 0, 2);
   uint right = bitfieldExtract (data, 2, 2);
   uint up = bitfieldExtract (data, 4, 2);
   uint down = bitfieldExtract (data, 6, 2);
   if (dashCount != 0)
   {
      if (left != 0 || right != 0)
      {
         if (!inDash (pixel.x, size.x, dashCount))
            return 0.0;
         float thickness = left == 2 || right == 2 ? lightThickness * 2.0 : lightThickness;
         float center = strokeCenter (size.y, lightThickness);
         return intervalCoverage (pixel.y, center - thickness * 0.5, center + thickness * 0.5);
      }
      if (!inDash (pixel.y, size.y, dashCount))
         return 0.0;
      float thickness = up == 2 || down == 2 ? lightThickness * 2.0 : lightThickness;
      float center = strokeCenter (size.x, lightThickness);
      return intervalCoverage (pixel.x, center - thickness * 0.5, center + thickness * 0.5);
   }
   return axisAlignedCoverage (data, pixel, size, lightThickness);
}

float blockCoverage (uint codepoint, ivec2 pixel, ivec2 size)
{
   if (codepoint >= 0x2591u && codepoint <= 0x2593u)
   {
      // The shades as an ordered 4x4 Bayer pattern: pixel-stable at 4,
      // 8, and 12 sixteenths.
      const int bayer [16] = int [16] (0, 8, 2, 10, 12, 4, 14, 6,
                                       3, 11, 1, 9, 15, 7, 13, 5);
      int level = int (codepoint - 0x2590u) * 4;
      return bayer [(pixel.y & 3) * 4 + (pixel.x & 3)] < level ? 1.0 : 0.0;
   }
   int x0 = 0;
   int x1 = 8;
   int y0 = 0;
   int y1 = 8;
   if (codepoint == 0x2580u)
      y1 = 4;
   else if (codepoint <= 0x2588u)
      y0 = 8 - int (codepoint - 0x2580u);
   else if (codepoint <= 0x258fu)
      x1 = 8 - int (codepoint - 0x2588u);
   else if (codepoint == 0x2590u)
      x0 = 4;
   else if (codepoint == 0x2594u)
      y1 = 1;
   else if (codepoint == 0x2595u)
      x0 = 7;
   else
   {
      // Quadrant bits: 1 upper left, 2 upper right, 4 lower left,
      // 8 lower right.
      const uint quadrants [10] = uint [10] (
         0x4u, 0x8u, 0x1u, 0xdu, 0x9u, 0x7u, 0xbu, 0x2u, 0x6u, 0xeu);
      uint mask = quadrants [codepoint - 0x2596u];
      int quadrantX = pixel.x < size.x * 4 / 8 ? 0 : 1;
      int quadrantY = pixel.y < size.y * 4 / 8 ? 0 : 1;
      return (mask & (1u << uint (quadrantY * 2 + quadrantX))) != 0u
         ? 1.0 : 0.0;
   }
   bool inside =
      pixel.x >= size.x * x0 / 8 && pixel.x < size.x * x1 / 8 &&
      pixel.y >= size.y * y0 / 8 && pixel.y < size.y * y1 / 8;
   return inside ? 1.0 : 0.0;
}

float scanLineCoverage (uint codepoint, ivec2 pixel, ivec2 size)
{
   const int positions [4] = int [4] (1, 3, 7, 9);
   float center = float (size.y * positions [codepoint - 0x23bau]) / 10.0;
   float thickness = max (0.001, parameters.boxDrawingStroke);
   return intervalCoverage (pixel.y, center - thickness * 0.5,
                             center + thickness * 0.5);
}

float dentistryCoverage (uint codepoint, ivec2 pixel, ivec2 size)
{
   // The straight dentistry brackets hug the cell edges: a full height
   // vertical on the side the symbol names and a full width horizontal
   // at its top or bottom, so consecutive rows chain into one bracket
   // the way the symbols mark a span.
   float thickness = max (0.001, parameters.boxDrawingStroke);
   bool top = codepoint == 0x23beu || codepoint == 0x23cbu;
   bool right = codepoint == 0x23cbu || codepoint == 0x23ccu;
   float vertical = right
      ? intervalCoverage (pixel.x, float (size.x) - thickness, float (size.x))
      : intervalCoverage (pixel.x, 0.0, thickness);
   float horizontal = top
      ? intervalCoverage (pixel.y, 0.0, thickness)
      : intervalCoverage (pixel.y, float (size.y) - thickness, float (size.y));
   return vertical + horizontal - vertical * horizontal;
}

float insideCoverage (float distance)
{
   return 1.0 - smoothstep (-0.5, 0.5, distance);
}

float mediaCoverage (uint codepoint, ivec2 pixel, ivec2 size)
{
   // The media-control symbols as signed distances inside a square
   // inset into the cell, antialiased over one pixel.
   vec2 delta = vec2 (pixel) + 0.5 - vec2 (size) * 0.5;
   int shortSide = min (size.x, size.y);
   float halfSide = float (shortSide - 2 * max (1, shortSide / 8)) * 0.5;
   if (codepoint == 0x23f8u)
   {
      float barX = abs (abs (delta.x) - halfSide * 0.55) - halfSide * 0.35;
      float barY = abs (delta.y) - halfSide;
      return insideCoverage (max (barX, barY));
   }
   if (codepoint == 0x23f9u)
      return insideCoverage (
         max (abs (delta.x), abs (delta.y)) - halfSide * 0.9);
   if (codepoint == 0x23fau)
      return insideCoverage (length (delta) - halfSide);
   // The four triangles fold onto one axis with the apex positive.
   bool vertical = codepoint == 0x23f6u || codepoint == 0x23f7u;
   bool negative = codepoint == 0x23f4u || codepoint == 0x23f6u;
   float along = (vertical ? delta.y : delta.x) * (negative ? -1.0 : 1.0);
   float across = abs (vertical ? delta.x : delta.y);
   float slope = (across - (halfSide - along) * 0.5) / 1.118034;
   float base = -halfSide - along;
   return insideCoverage (max (slope, base));
}

bool nonRenderingCodepoint (uint codepoint)
{
   return codepoint == 0x200du ||
          (codepoint >= 0xfe00u && codepoint <= 0xfe0fu) ||
          (codepoint >= 0xe0100u && codepoint <= 0xe01efu);
}

float glyphCoverage (uint codepoint, uint strip, uint stripStride,
                     uint lineAttribute, ivec2 pixel, ivec2 cellSize,
                     out vec4 intrinsicColor)
{
   intrinsicColor = vec4 (0.0);
   if (strip == 0xffffffffu)
   {
      if (nonRenderingCodepoint (codepoint))
         return 0.0;
      if (codepoint >= 0x2500u && codepoint <= 0x257fu)
         return boxDrawingCoverage (codepoint, pixel, cellSize);
      if (codepoint >= 0x2580u && codepoint <= 0x259fu)
         return blockCoverage (codepoint, pixel, cellSize);
      if (codepoint >= 0x23bau && codepoint <= 0x23bdu)
         return scanLineCoverage (codepoint, pixel, cellSize);
      if (codepoint == 0x23beu || codepoint == 0x23bfu ||
          codepoint == 0x23cbu || codepoint == 0x23ccu)
         return dentistryCoverage (codepoint, pixel, cellSize);
      if (codepoint >= 0x23f4u && codepoint <= 0x23fau)
         return mediaCoverage (codepoint, pixel, cellSize);
      return 0.0;
   }

   // The strips hold single-density slices; double-size lines sample
   // them at half rate. pixel arrives in the doubled coordinate space.
   int sampleX = lineAttribute != 0u ? pixel.x / 2 : pixel.x;
   int sampleY = lineAttribute == 2u || lineAttribute == 3u
      ? pixel.y / 2 : lineAttribute == 1u && pixel.y >= int (parameters.glyphHeight)
      ? pixel.y - int (parameters.glyphHeight) : pixel.y;
   uint index = (strip & 0x7fffffffu) +
                uint (sampleY) * stripStride + uint (sampleX);
   if ((strip & 0x80000000u) != 0u)
   {
      uint texel = colorArena[index];
      intrinsicColor = vec4 (
         float (texel & 0xffu),
         float ((texel >> 8u) & 0xffu),
         float ((texel >> 16u) & 0xffu),
         float ((texel >> 24u) & 0xffu)) / 255.0;
      return 0.0;
   }
   uint texel = maskArena[index >> 2u];
   return float ((texel >> (8u * (index & 3u))) & 0xffu) / 255.0;
}

void main ()
{
   uint updateIndex = gl_GlobalInvocationID.x;
   if (updateIndex >= parameters.updateCount)
      return;

   CellUpdate update = updates [updateIndex];
   uint sourceRow = update.sourceIndex / parameters.columns;
   uint sourceColumn = update.sourceIndex -
                       sourceRow * parameters.columns;
   uint outputRow = update.outputIndex / parameters.columns;
   uint outputColumn = update.outputIndex -
                       outputRow * parameters.columns;
   if (sourceColumn >= parameters.columns ||
       sourceRow >= parameters.rows ||
       outputColumn >= parameters.columns ||
       outputRow >= parameters.rows)
      return;

   uvec2 globalPosition = uvec2 (outputColumn, outputRow);
   ivec2 cellPosition = ivec2 (sourceColumn, sourceRow);
   uint lineAttribute = update.cell.lineAttribute;
   bool doubleLine = lineAttribute != 0;
   Cell cell = update.cell;

   uint doubleWidth = doubleLine ? 1u : bitfieldExtract (cell.charData, 16, 1);
   uint underline = bitfieldExtract (cell.charData, 4, 1);
   uint inverse = bitfieldExtract (cell.charData, 5, 1);
   uint wrap = bitfieldExtract (cell.charData, 6, 1);
   uint faint = bitfieldExtract (cell.charData, 8, 1);
   uint blink = bitfieldExtract (cell.charData, 9, 1);
   uint conceal = bitfieldExtract (cell.charData, 10, 1);
   uint strike = bitfieldExtract (cell.charData, 11, 1);
   uint overline = bitfieldExtract (cell.charData, 12, 1);
   uint underlineStyle = bitfieldExtract (cell.charData, 13, 3);
   uint codepoint = cell.codepoint;
   vec3 foreground = unpackColor (cell.fg);
   vec3 background = unpackColor (cell.bg);
   vec3 cursor = unpackColor (parameters.cursorColor);
   vec3 underlineColor = unpackColor (cell.underlineColor);

   if ((inverse != 0) != (parameters.screenReverseVideo != 0))
   {
      vec3 temporary = foreground;
      foreground = background;
      background = temporary;
   }
   bool selectedCell = selected (cellPosition, doubleWidth);
   if (selectedCell)
   {
      if (parameters.selectionColorMask == 0)
      {
         vec3 temporary = foreground;
         foreground = background;
         background = temporary;
      }
      else
      {
         if ((parameters.selectionColorMask & 1u) != 0)
            foreground = unpackColor (parameters.selectionForeground);
         if ((parameters.selectionColorMask & 2u) != 0)
            background = unpackColor (parameters.selectionBackground);
      }
   }
   if (faint != 0)
      foreground = mix (foreground, background, 0.5);
   if (conceal != 0)
      foreground = background;
   if (blink != 0 && parameters.blinkVisible == 0)
      foreground = background;
   bool explicitLink = cell.hyperlink != 0 &&
      cell.hyperlink == parameters.hoveredHyperlink;
   bool plainLink = update.sourceIndex >= parameters.hoveredLinkBegin &&
      update.sourceIndex < parameters.hoveredLinkEnd;
   if (underline == 0 && (explicitLink || plainLink))
   {
      underline = 1;
      underlineStyle = 1;
      underlineColor = foreground;
   }
   if (all (equal (cursor, background)))
      cursor = vec3 (1.0) - cursor;

   bool cursorHere = cellPosition.x == parameters.cursorX &&
                     cellPosition.y == parameters.cursorY;
   cursorHere = cursorHere &&
      (parameters.cursorBlink == 0 || parameters.blinkVisible != 0);
   if (cursorHere && parameters.cursorStyle == 1)
   {
      if (!(selectedCell || inverse != 0) || parameters.cursorKeepSelectionFg == 0)
         foreground = background;
      background = cursor;
   }

   uint cellWidth = parameters.glyphWidth;
   ivec2 outputOrigin = ivec2 (
      int (parameters.originX + globalPosition.x * parameters.glyphWidth),
      int (parameters.originY + globalPosition.y * parameters.glyphHeight));

   for (uint y = 0; y < parameters.glyphHeight; ++y)
   {
      for (uint x = 0; x < cellWidth; ++x)
      {
         ivec2 pixel = ivec2 (
            int (x + (doubleLine ? (globalPosition.x & 1u) *
                                  parameters.glyphWidth : 0u)),
            int (y + (lineAttribute == 2u ? parameters.glyphHeight : 0u)));
         ivec2 size = ivec2 (
            doubleLine ? parameters.glyphWidth * 2u : cellWidth,
            lineAttribute == 1u || lineAttribute == 2u
               ? parameters.glyphHeight * 2u : parameters.glyphHeight);
         vec4 intrinsicColor;
         float coverage = glyphCoverage (
            codepoint, cell.strip, cell.stripStride, lineAttribute,
            pixel, size, intrinsicColor);
         vec3 color;
         if (intrinsicColor.a != 0.0 &&
             conceal == 0 &&
             (blink == 0 || parameters.blinkVisible != 0))
         {
            if (faint != 0)
               intrinsicColor *= 0.5;
            color = intrinsicColor.rgb +
                    background * (1.0 - intrinsicColor.a);
         }
         else
         {
            color = foreground * coverage +
                    background * (1.0 - coverage);
         }
         storePixel (outputOrigin + pixel, color);
      }
   }

   if (underline != 0)
   {
      for (uint x = 0; x < cellWidth; ++x)
      {
         bool draw = underlineStyle != 4 || (x & 1u) == 0u;
         draw = draw && (underlineStyle != 5 || (x % 6u) < 4u);
         uint waveY = underlineStyle == 3 ? (x & 1u) : 0u;
         if (draw)
            storePixel (
               outputOrigin + ivec2 (
                  x, parameters.glyphHeight - 1 - int (waveY)),
               underlineColor);
         if (underlineStyle == 2 && parameters.glyphHeight > 2)
            storePixel (
               outputOrigin + ivec2 (x, parameters.glyphHeight - 3),
               underlineColor);
      }
   }

   if (strike != 0)
      for (uint x = 0; x < cellWidth; ++x)
         storePixel (
            outputOrigin + ivec2 (x, parameters.glyphHeight / 2),
            foreground);

   if (overline != 0)
      for (uint x = 0; x < cellWidth; ++x)
         storePixel (outputOrigin + ivec2 (x, 0), foreground);

   if (parameters.showWraps != 0 && wrap != 0)
   {
      for (uint y = 0; y < parameters.glyphHeight; y += 2)
         storePixel (
            outputOrigin + ivec2 (cellWidth - 1, y), foreground);
   }

   if (cursorHere && parameters.cursorStyle == 2)
   {
      for (uint x = 0; x < cellWidth; ++x)
      {
         storePixel (outputOrigin + ivec2 (x, 0), cursor);
         storePixel (
            outputOrigin + ivec2 (x, parameters.glyphHeight - 1), cursor);
      }
      for (uint y = 1; y + 1 < parameters.glyphHeight; ++y)
      {
         storePixel (outputOrigin + ivec2 (0, y), cursor);
         storePixel (outputOrigin + ivec2 (cellWidth - 1, y), cursor);
      }
   }
   else if (cursorHere && parameters.cursorStyle == 3)
   {
      uint thickness = max (1u, parameters.glyphHeight / 8u);
      for (uint y = parameters.glyphHeight - thickness;
           y < parameters.glyphHeight; ++y)
      {
         for (uint x = 0; x < cellWidth; ++x)
            storePixel (outputOrigin + ivec2 (x, y), cursor);
      }
   }
   else if (cursorHere && parameters.cursorStyle == 4)
   {
      uint thickness = max (1u, parameters.glyphWidth / 6u);
      for (uint y = 0; y < parameters.glyphHeight; ++y)
      {
         for (uint x = 0; x < thickness; ++x)
            storePixel (outputOrigin + ivec2 (x, y), cursor);
      }
   }
}
